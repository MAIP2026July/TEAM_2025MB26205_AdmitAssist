      "sibling_in_school": 1,
      "grade_identified_and_offered": 1,
      "timeframe_later_than_next_session": -4,
      "explicitly_exploratory": -3,
      "grade_not_offered": -6
    },
    "high_threshold": 4,
    "low_threshold": 0,
    "_bands": "score >= high_threshold -> HIGH; score <= low_threshold -> LOW; otherwise MEDIUM",
    "immediate_window_days": 60,
    "disagreement_policy": "take_higher",
    "_disagreement_note": "If the AI's own suggested priority is higher than the rules' result, the higher one is used and the card says so.",
    "low_allowed_only_when_confidence": "HIGH",
